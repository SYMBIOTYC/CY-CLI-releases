#!/bin/bash
# CY-CLI macOS app launcher.
#
# The app bundle's Info.plist points CFBundleExecutable at this script. It:
#   1. Resolves a CY API key (env, keychain, ~/.cy/auth.json) and writes it
#      to ~/.cy/auth.json so the bundled `cy` CLI can authenticate.
#   2. Starts the local responses->chat bridge (if not already running) and
#      passes the key into its environment.
#   3. Writes a default ~/.cy config pointing at the bridge.
#   4. Opens Terminal.app running the bundled `cy` binary (real TTY so the TUI
#      works), with CY_API_KEY exported in that shell. The first screen of
#      the spawned Terminal shows a big pink CY ASCII-art logo so users
#      know the brand before the TUI takes over.
set -e

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CY_BIN="$APP_DIR/MacOS/cy"
BRIDGE="$APP_DIR/Resources/cy_bridge.py"

CY_HOME="${CY_HOME:-$HOME/.cy}"
PORT="${CY_BRIDGE_PORT:-8790}"
mkdir -p "$CY_HOME"

AUTH_FILE="$CY_HOME/auth.json"
CONFIG="$CY_HOME/config.toml"

# --- Resolve the API key (env, auth.json, keychain) ------------------------
KEY="${CY_API_KEY:-}"
if [ -z "$KEY" ] && [ -f "$AUTH_FILE" ]; then
  KEY="$(python3 -c "
import json, sys
try:
    with open('$AUTH_FILE') as f:
        data = json.load(f)
    v = data.get('cy_api_key') or data.get('CY_API_KEY') or ''
    print(v if isinstance(v, str) else '')
except Exception:
    print('')
" 2>/dev/null || true)"
fi
# Strip surrounding whitespace.
KEY="$(printf '%s' "$KEY" | tr -d '[:space:]')"

if [ -z "$KEY" ]; then
  # Try the macOS keychain (if user added it with `security add-generic-password`).
  KEY="$(security find-generic-password -s cy-cli-api-key -w 2>/dev/null || true)"
  KEY="$(printf '%s' "$KEY" | tr -d '[:space:]')"
fi

if [ -z "$KEY" ]; then
  # No key anywhere: start local auth server, open browser, wait for key
  AUTH_SERVER="$APP_DIR/Resources/cy_auth_server.py"
  if [ -f "$AUTH_SERVER" ]; then
    cat <<'AUTH_MSG' >&2

  ██████╗██╗   ██╗
 ██╔════╝╚██╗ ██╔╝
 ██║      ╚████╔╝
 ██║       ╚██╔╝
 ╚██████╗   ██║
  ╚═════╝   ╚═╝

  Запускаем авторизацию через Google...
  Откроется браузер — войди через Google.
  Ключ автоматически сохранится в ~/.cy/auth.json

AUTH_MSG
    # Start auth server and wait for key
    python3 "$AUTH_SERVER" &
    AUTH_PID=$!
    # Wait up to 5 minutes for auth
    wait $AUTH_PID 2>/dev/null || true
    # Re-read key from auth.json
    if [ -f "$AUTH_FILE" ]; then
      KEY="$(python3 -c "
import json, sys
try:
    with open('$AUTH_FILE') as f:
        data = json.load(f)
    v = data.get('cy_api_key') or data.get('CY_API_KEY') or ''
    print(v if isinstance(v, str) else '')
except Exception:
    print('')
" 2>/dev/null || true)"
      KEY="$(printf '%s' "$KEY" | tr -d '[:space:]')"
    fi
    if [ -z "$KEY" ]; then
      cat <<'NO_KEY' >&2
  Авторизация не завершена.
  Попробуй снова:  cy login --with-api-key
  Или:  export CY_API_KEY=cfat_...
NO_KEY
      exit 1
    fi
  else
    # Fallback: open browser for manual flow
    open "https://auth.symbiotyc.workers.dev" 2>/dev/null || true
    cat <<'NO_KEY' >&2

  ██████╗██╗   ██╗
 ██╔════╝╚██╗ ██╔╝
 ██║      ╚████╔╝
 ██║       ╚██╔╝
 ╚██████╗   ██║
  ╚═════╝   ╚═╝

  Тебе нужен API ключ.
  Открыли страницу авторизации в браузере: https://auth.symbiotyc.workers.dev
  1. Войди через Google — получишь ключ вида cfat_...
  2. Сохрани его:  cy login --with-api-key
     или:  export CY_API_KEY=cfat_...
  3. Запусти CY заново.

NO_KEY
    exit 1
  fi
fi

# --- Write auth.json (overwrite empty one) ----------------------------------
printf '{\n  "auth_mode": "apiKey",\n  "cy_api_key": "%s"\n}\n' "$KEY" > "$AUTH_FILE"
chmod 600 "$AUTH_FILE"

# --- Start the local bridge if it is not already running -------------------
if ! bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
  PYTHON="$(command -v python3 || true)"
  if [ -z "$PYTHON" ]; then
    echo "CY: python3 not found. Install Python 3 and try again." >&2
    exit 1
  fi
  CY_API_BASE_URL="${CY_API_BASE_URL:-https://cy.symbiotyc.workers.dev/v1}" \
  CY_BRIDGE_PORT="$PORT" \
  CY_HOME="$CY_HOME" \
  CY_API_KEY="$KEY" \
  nohup "$PYTHON" "$BRIDGE" >"$CY_HOME/bridge.log" 2>&1 &
  disown 2>/dev/null || true
  for _ in $(seq 1 50); do
    if bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
fi

# --- Seed SYMBIOTYC-branded syntax themes on first launch ------------------
# The 7 .tmTheme files ship inside Contents/Resources/themes/ in the .app
# bundle. We copy them into ~/.cy/themes/ if the user has never had any of
# our themes installed before. Re-running the launcher is safe: existing
# files are never overwritten (the user might have edited one).
THEMES_SRC="$APP_DIR/Resources/themes"
THEMES_DST="$CY_HOME/themes"
if [ -d "$THEMES_SRC" ]; then
  mkdir -p "$THEMES_DST"
  for t in "$THEMES_SRC"/*.tmTheme; do
    [ -f "$t" ] || continue
    name="$(basename "$t")"
    if [ ! -f "$THEMES_DST/$name" ]; then
      cp "$t" "$THEMES_DST/$name"
    fi
  done
fi

# --- Config (always written to ensure correct port) ---
cat > "$CONFIG" <<EOF
# CY Config - generated by CY-CLI launcher
model = "cy/i1a"
model_provider = "symbiotyc"
model_context_window = 128000
model_auto_compact_token_limit = 96000
model_reasoning_summary = "auto"
model_reasoning_effort = "none"
approval_policy = "never"

[model_providers.symbiotyc]
name = "SYMBIOTYC"
base_url = "http://127.0.0.1:$PORT/v1"
wire_api = "responses"
supports_websockets = false
models = ["cy/i1a"]
EOF

# --- Build the first-screen splash (big pink CY ASCII art) -----------------
# We build the splash with $'...' (ANSI-C quoting) so the escape character
# is the literal 0x1B byte — Terminal.app will then render the colours.
#   1;35 = bold magenta (pink), 0 = reset, 1;36 = bold cyan, 2;37 = dim grey.
ESC=$'\033'
PINK="${ESC}[1;35m"
CYAN="${ESC}[1;36m"
DIM="${ESC}[2;37m"
RESET="${ESC}[0m"

SPLASH_FILE="$CY_HOME/.splash.ansi"
cat > "$SPLASH_FILE" <<SPLASH_EOF
${PINK}
  ██████╗██╗   ██╗
 ██╔════╝╚██╗ ██╔╝
 ██║      ╚████╔╝
 ██║       ╚██╔╝
 ╚██████╗   ██║
  ╚═════╝   ╚═╝${RESET}

 ${PINK}CY${RESET} ${DIM}— Symbiotic Coding Assistant${RESET}
 ${DIM}Loading TUI...${RESET}
SPLASH_EOF

# --- Open Terminal with the splash, then the CLI ---------------------------
export CX_HOME="$CY_HOME"
export CODEX_HOME="$CY_HOME"
export CY_API_KEY="$KEY"

# Write a .command file that Terminal can execute directly.
# This avoids the need for AppleScript Automation permissions.
CMD_FILE="$CY_HOME/.cy_launch.command"
cat > "$CMD_FILE" <<CMD_EOF
#!/bin/bash
export CX_HOME='$CY_HOME'
export CODEX_HOME='$CY_HOME'
export CY_API_KEY='$KEY'
export PS1='\\$ '
export PROMPT_EOL=''
clear
cat '$SPLASH_FILE'
cd '$HOME' && '$CY_BIN'
rm -f '$SPLASH_FILE'
rm -f '$CMD_FILE'
CMD_EOF
chmod +x "$CMD_FILE"

open -a Terminal "$CMD_FILE"
